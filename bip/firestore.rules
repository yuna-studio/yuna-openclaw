rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /chat_logs/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /reactions/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /counters/{docId} {
      allow read: if true;
      allow write: if true;
    }
    // 프로젝트 (제품 단위)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if false; // 서버(admin SDK)만 쓰기
    }
    // 프로젝트별 작업 문서
    match /projects/{projectId}/works/{workId} {
      allow read: if true;
      allow write: if false; // 서버(admin SDK)만 쓰기
    }
  }
}
